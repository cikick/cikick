    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "tsdown": "0.23.7",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@10.28.0"
}
