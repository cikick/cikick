---
type Cell = [mark: 'y' | 'p' | 'n' | 'u' | 'na', text: string];
const cols = ['Shared across repos', 'Per-repo customisation', 'Breaking-change migrations', 'SHA pinning', 'Lockfile', 'Secret distribution / fleet ops', 'Static analysis', 'No build step', 'Maturity'];
const rows: { name: string; us?: boolean; cells: Cell[] }[] = [
  { name: 'cikick', us: true, cells: [
    ['y', 'npm packages'], ['y', 'props, addOverride, aspects'], ['y', 'versioned codemods via cikick update'],
    ['y', 'at synth; refreshing is manual (lock --refresh)'], ['y', 'cikick.lock.json'],
    ['p', 'age report, pushes a value you provide to selected repos; no mint/revoke'], ['p', '5 stock checks + custom Checks'],
    ['n', 'synth step'], ['n', '0.1, unpublished'] ] },
  { name: 'Reusable workflows', cells: [
    ['y', 'native'], ['p', 'inputs, secrets, job-level settings; not steps'], ['n', ''], ['p', 'caller pins by hand'], ['n', ''], ['n', ''], ['n', ''], ['y', ''], ['y', 'GA'] ] },
  { name: 'Composite actions', cells: [
    ['p', 'steps only'], ['p', 'inputs only'], ['n', ''], ['p', 'by hand'], ['n', ''], ['n', ''], ['n', ''], ['y', ''], ['y', 'GA'] ] },
  { name: 'Org rulesets / required workflows', cells: [
    ['y', 'enforced centrally'], ['n', 'same workflow everywhere'], ['n', ''], ['p', 'by hand in the one file'], ['n', ''], ['n', ''], ['n', ''], ['y', ''], ['y', 'plan availability: unverified'] ] },
  { name: 'Org-level secrets', cells: [
    ['y', ''], ['p', 'select repos; one value'], ['na', ''], ['na', ''], ['na', ''], ['p', 'one value, many repos; no age policy'], ['na', ''], ['y', ''], ['y', ''] ] },
  { name: 'Renovate / Dependabot', cells: [
    ['n', 'per-repo copies'], ['na', ''], ['n', 'bumps strings'], ['y', 'Renovate digest pinning'], ['n', ''], ['n', ''], ['n', ''], ['y', ''], ['y', ''] ] },
  { name: 'File-sync / multi-repo PR tools', cells: [
    ['p', 'copy files out'], ['u', 'via templating'], ['p', 'scripted, not versioned'], ['n', ''], ['n', ''], ['n', ''], ['n', ''], ['y', ''], ['p', 'varies'] ] },
  { name: 'projen', cells: [
    ['y', 'npm packages'], ['y', 'escape hatches'], ['u', 're-synth; shipped codemods not known'], ['u', ''], ['u', ''], ['n', ''], ['n', ''], ['n', 'synth step'], ['y', 'widely used'] ] },
  { name: 'github-workflows-kt', cells: [
    ['p', 'Kotlin scripts/libs'], ['y', 'code'], ['u', 'not known'], ['u', ''], ['u', ''], ['n', ''], ['y', 'typed action inputs'], ['n', 'script step'], ['p', 'active, niche'] ] },
  { name: 'zizmor / actionlint', cells: [
    ['na', 'analysis only'], ['na', ''], ['n', ''], ['p', 'zizmor flags unpinned uses'], ['n', ''], ['n', ''], ['y', 'deeper than cikick'], ['y', ''], ['y', ''] ] },
];
const sym = { y: '✓', p: '~', n: '✗', u: '?', na: '–' } as const;
const word = { y: 'Yes', p: 'Partly', n: 'No', u: 'Unverified', na: 'Not applicable' } as const;
const notes = [
  ['Reusable workflows', 'the right default for "same pipeline, a few inputs". Pointing callers at <code>@main</code> avoids bump PRs but ships unreviewed changes to every repo at once; pinning avoids that but means a bump PR per caller.'],
  ['Composite actions', 'keep them; they bundle steps. cikick generates the workflow skeleton that calls them.'],
  ['Renovate', 'cikick uses it as the delivery truck: bump the package, then <code>cikick update</code> migrates and re-synths.'],
  ['Rulesets / org secrets', 'if central enforcement or one shared value is all you need, use them and skip cikick.'],
  ['projen / github-workflows-kt', 'alternatives, not companions: pick one generator per repo, by language and scope.'],
  ['zizmor / actionlint', 'run them on cikick\'s generated YAML too.'],
];
---
<section id="why-not" class="sec" aria-labelledby="why-title">
  <div class="wrap">
    <p class="eyebrow">Why not just…</p>
    <h2 id="why-title">Honest comparisons.</h2>
    <p class="sec-lede">
      Most of these beat cikick at the thing they do. cikick earns its place only when you need <em>shared, versioned, migratable</em> workflows across many repos, and it costs you a build step and a pre-release dependency.
    </p>
    <div class="cmp-wrap" role="region" aria-label="Comparison table, scrollable" tabindex="0">
      <table class="cmp">
        <caption class="sr-only">cikick compared with alternatives across nine capabilities. Symbols: check is yes, tilde is partly, cross is no, question mark is unverified, dash is not applicable.</caption>
        <thead>
          <tr><th scope="col">Tool</th>{cols.map((c) => <th scope="col">{c}</th>)}</tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr class={r.us ? 'us' : ''}>
              <th scope="row">{r.name}</th>
              {r.cells.map(([m, t]) => (
                <td class={`c-${m}`}><span class="mk" aria-hidden="true">{sym[m]}</span><span class="sr-only">{word[m]}{t ? ': ' : ''}</span>{t && <span class="ct">{t}</span>}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note">Third-party cells reflect our reading of their docs as of Nov 2026. Cells marked <b>?</b> are ones we have not confirmed. Corrections welcome via a <a href="https://github.com/cikick/cikick/issues">GitHub issue</a>.</p>
    <ul class="notes">
      {notes.map(([n, t]) => <li><b>{n}:</b> <span set:html={t}></span></li>)}
    </ul>
    <div class="fit">
      <div class="card">
        <h3>cikick is a good fit when</h3>
        <ul>
          <li>You have roughly 10+ repos with similar pipelines, and a team that can own a shared package.</li>
          <li>Breaking changes to shared CI happen, and you want them as migrations, not announcements.</li>
          <li>Auditors or security want every action pinned and every secret on a rotation clock.</li>
        </ul>
      </div>
      <div class="card">
        <h3>It is probably the wrong call when</h3>
        <ul>
          <li>You have a handful of repos. Reusable workflows plus Renovate are less machinery.</li>
          <li>Nobody wants a build step between editing CI and running it. cikick adds one, and needs Node in every repo.</li>
          <li>You need a mature, battle-tested ecosystem today. cikick is version 0.1.</li>
        </ul>
      </div>
    </div>
  </div>
</section>
