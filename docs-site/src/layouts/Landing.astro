---
import '../styles/tokens.css';
import '../styles/landing.css';
interface Props { title: string; description: string }
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const docs = (p: string) => `${base}/docs/${p}`;
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var t;
        try { t = localStorage.getItem('starlight-theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        d.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav">
      <div class="wrap nav-in">
        <a class="brand" href={`${base}/`} aria-label="cikick home">
          <img src={`${base}/favicon.svg`} alt="" width="28" height="28" />
          <span>cikick</span>
        </a>
        <nav aria-label="Primary" class="nav-links">
          <a href={docs('concepts/constructs-and-synth/')}>Concepts</a>
          <a href={docs('reference/cikick-cli/')}>Reference</a>
        </nav>
        <div class="nav-end">
          <button id="theme-toggle" class="icon-btn" type="button" aria-label="Toggle light/dark theme">
            <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="currentColor"/><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.5 1.5M17.5 17.5L19 19M5 19l1.5-1.5M17.5 6.5L19 5"/></g></svg>
            <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z" fill="currentColor"/></svg>
          </button>
          <a class="btn btn-sm" href={docs('guides/quickstart/')}>Docs</a>
        </div>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="foot">
      <div class="wrap foot-in">
        <p>cikick: CDK-style workflow manager for GitHub Actions.</p>
        <nav aria-label="Footer">
          <a href="https://github.com/cikick/cikick">GitHub</a>
          <a href={docs('')}>Docs</a>
          <a href={docs('reference/cikick-cli/')}>CLI reference</a>
        </nav>
      </div>
    </footer>
    <script>
      // Theme toggle (shares Starlight's storage key so docs and landing agree)
      const root = document.documentElement;
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('starlight-theme', next); } catch {}
      });

      // Play each [data-anim] block once when it scrolls into view; [data-replay] re-runs it.
      const blocks = Array.from(document.querySelectorAll<HTMLElement>('[data-anim]'));
      const play = (el: HTMLElement) => {
        el.classList.remove('is-playing');
        void el.offsetWidth; // restart CSS animations
        el.classList.add('is-playing');
      };
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                play(e.target as HTMLElement);
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.35 },
        );
        blocks.forEach((b) => io.observe(b));
      } else blocks.forEach(play);
      document.querySelectorAll<HTMLButtonElement>('[data-replay]').forEach((btn) =>
        btn.addEventListener('click', () => {
          const target = document.getElementById(btn.dataset.replay!);
          if (target) play(target);
        }),
      );

      // Copy buttons
      document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) =>
        btn.addEventListener('click', async () => {
          const text = document.getElementById(btn.dataset.copy!)?.innerText ?? '';
          try {
            await navigator.clipboard.writeText(text);
            btn.textContent = 'Copied';
            setTimeout(() => (btn.textContent = 'Copy'), 1600);
          } catch {}
        }),
      );
    </script>
  </body>
</html>
