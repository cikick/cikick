{
  // Cloudflare Workers config for the docs site (static assets only, no Worker script).
  // Used when Workers Builds / `npx wrangler deploy` runs from the REPO ROOT.
  // IMPORTANT: `name` must match the Worker name in the Cloudflare dashboard
  // (Workers & Pages -> your Worker -> Settings), otherwise the deploy targets a different Worker.
  "name": "cikick",
  "compatibility_date": "2026-11-01",
  // Required by `wrangler preview` (non-production builds); empty = same settings as production.
  "previews": {},
  "assets": {
    "directory": "./docs-site/dist",
    "not_found_handling": "404-page",
  },
  // Runs before `wrangler deploy` locally / in generic CI. NOTE: Cloudflare Workers Builds does NOT
  // honour this block, so also set the dashboard Build command to the same string (see docs-site/README.md).
  "build": {
    "command": "pnpm install --frozen-lockfile && pnpm --filter cikick-docs-site build",
  },
}
