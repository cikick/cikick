{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "github-actions": {
    "enabled": false
  },
  "packageRules": [
    {
      "matchPackageNames": [
        "@acme/wf-node-ci",
        "/^@cikick\\//"
      ],
      "groupName": "cikick",
      "postUpgradeTasks": {
        "commands": [
          "npx cikick update"
        ],
        "fileFilters": [
          ".github/**",
          "cikick.lock.json",
          "renovate.json",
          ".nvmrc"
        ],
        "executionMode": "branch"
      }
    }
  ],
  "schedule": [
    "before 5am on monday"
  ],
  "labels": [
    "dependencies"
  ]
}
