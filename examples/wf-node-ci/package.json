{
  "name": "@acme/wf-node-ci",
  "version": "2.0.0",
  "private": true,
  "description": "Example shared cikick package: Node CI construct, managed config files and migrations",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "cikick": "./dist/cikick.js",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "CHANGELOG.md"],
  "scripts": { "build": "tsc -p tsconfig.json", "test": "vitest run" },
  "dependencies": { "@cikick/core": "workspace:*", "constructs": "^10.8.1", "ts-morph": "^28.0.0" }
}
